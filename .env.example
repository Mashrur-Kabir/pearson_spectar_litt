# ── REQUIRED ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional (defaults shown) ─────────────────────────────────────────────
GEMINI_MODEL=gemini-3-flash-preview         
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_COLLECTION=legal_docs

# ── Cloud Databases (Required for Production) ─────────────────────────────────

# 1. Supabase (Relational Database)
# Get these at https://supabase.com > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# 2. Pinecone (Vector Database)
# Get this at https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=legal-ai-index800

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval
RETRIEVAL_TOP_K=15

# Generation
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.2

# OCR
TESSERACT_CMD=tesseract
OCR_DPI=300

# API Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Streamlit (points to the FastAPI backend)
API_BASE_URL=http://localhost:8000